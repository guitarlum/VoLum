<?xml version="1.0" encoding="utf-8"?>
<!--
  Release|x64 optimization flags shared by the shipped app, the VST3 and the test binary, so the
  goldens and the realtime-budget test run the same codegen that ships. Import it only for
  Release|x64, after Microsoft.Cpp.props.

  The WholeProgramOptimization *property* is read inside Microsoft.Cpp.props, so a sheet imported
  after it cannot turn on the stock WPO defaults; the ClCompile/Link metadata below set them directly
  (x64 WPO default link mode is /LTCG:incremental).
-->
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemDefinitionGroup>
    <ClCompile>
      <Optimization>MaxSpeed</Optimization>
      <WholeProgramOptimization>true</WholeProgramOptimization>
      <IntrinsicFunctions>true</IntrinsicFunctions>
      <FavorSizeOrSpeed>Speed</FavorSizeOrSpeed>
      <FunctionLevelLinking>true</FunctionLevelLinking>
    </ClCompile>
    <Link>
      <LinkTimeCodeGeneration>UseFastLinkTimeCodeGeneration</LinkTimeCodeGeneration>
      <OptimizeReferences>true</OptimizeReferences>
      <EnableCOMDATFolding>true</EnableCOMDATFolding>
    </Link>
  </ItemDefinitionGroup>
</Project>
