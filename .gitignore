# Local-only research/research spike + reference docs (never to GitLab)
local-scratch/

# Generated by scripts/pitch-ab-render-win.ps1 -Baseline: a past revision of the
# pitch header, rewritten into a parallel namespace. Always regenerated from git.
NeuralAmpModeler/tools/pitch-ab/baseline_pitch.h

# Secrets / local env (API keys, never commit)
.env
.env.*
!.env.example

# Runtime settings (generated by VoLum, not tracked)
rigs/volum-settings.json

# A2 retraining staging (local only; final models land in rigs/ via migration).
# These hold the trained .nam set + curves/logs; too large + redundant to track.
training/a2-out/
training/a2-r2-out/
training/a2-final/
# Training input/reference binaries: large + re-downloadable (NAM standard v3
# input sweep, Tone3000 reference models). Keep the cloud toolkit, not the blobs.
training/*.wav
training/*.nam

# CI scratch logs (local watch/triage output, not tracked)
/ci-watch.log
/ci-failed-log.txt

NeuralAmpModeler/ui-mockup/
rigs/*/amp-pic-*
